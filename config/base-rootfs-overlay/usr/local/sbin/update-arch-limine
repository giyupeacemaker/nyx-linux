#!/usr/bin/env bash
set -euo pipefail

install_mode=0
if [[ "${1:-}" == "--install" ]]; then
    install_mode=1
fi

esp=/boot
marker="${esp}/.arch-limine"
kernel_path=""
initramfs_path=""

# Only touch the ESP when it is actually mounted, otherwise the pacman hook
# (non-install mode) would write EFI files onto the root filesystem. During a
# real installation Calamares has already mounted the ESP, so the check is
# skipped there.
if (( install_mode == 0 )) && ! findmnt -n "$esp" >/dev/null 2>&1; then
    echo "/boot is not a mounted filesystem; leaving Limine unchanged." >&2
    exit 0
fi

while IFS= read -r candidate; do
    if [[ -n "$candidate" ]]; then
        kernel_path="$candidate"
        break
    fi
done < <(find "$esp" -maxdepth 1 -type f -name 'vmlinuz-linux-cachyos' -print 2>/dev/null)

while IFS= read -r candidate; do
    if [[ -n "$candidate" ]]; then
        initramfs_path="$candidate"
        break
    fi
done < <(find "$esp" -maxdepth 1 -type f -name 'initramfs-linux-cachyos.img' -print 2>/dev/null)

if [[ -z "$kernel_path" || -z "$initramfs_path" ]]; then
    echo "CachyOS kernel files are not present; leaving Limine unchanged." >&2
    exit 0
fi

if (( install_mode == 0 )) && [[ ! -e "$marker" ]]; then
    exit 0
fi

# The base parameters and the Nyx tunables come from one place, so that this
# script and nyx-configure-bootloader cannot drift apart. See boot-params.
boot_params=/usr/local/lib/nyx/boot-params
if [[ ! -x "$boot_params" ]]; then
    echo "${boot_params} is missing; refusing to guess the kernel command line." >&2
    exit 1
fi

cmdline="$("$boot_params" base)"
extra="$("$boot_params" extra)"
if [[ -n "$extra" ]]; then
    cmdline+=" $extra"
fi

kernel_name="${kernel_path##*/}"
initramfs_name="${initramfs_path##*/}"
tmp_config="$(mktemp)"
trap 'rm -f "$tmp_config"' EXIT

cat >"$tmp_config" <<EOF
# Generated by update-arch-limine — do not edit by hand.
timeout: 5
quiet: yes
default_entry: 1
remember_last_entry: yes
interface_branding: NYX LINUX - ARCH-BASED
interface_branding_colour: 42A5F5
interface_help_hidden: yes
wallpaper_style: stretched

/Nyx Linux
    protocol: linux
    path: boot():/${kernel_name}
    module_path: boot():/${initramfs_name}
    cmdline: ${cmdline}
EOF

if [[ -f /usr/share/arch-custom/limine-bg.png ]]; then
    printf '%s\n' 'wallpaper: boot():/limine-bg.png' >>"$tmp_config"
    install -m 0644 /usr/share/arch-custom/limine-bg.png "${esp}/limine-bg.png"
fi

if [[ -f "${esp}/EFI/Microsoft/Boot/bootmgfw.efi" ]]; then
    cat >>"$tmp_config" <<'EOF'

/Windows
    protocol: efi
    path: boot():/EFI/Microsoft/Boot/bootmgfw.efi
EOF
fi

install -d -m 0755 "${esp}/EFI/arch-limine" "${esp}/EFI/BOOT"
install -m 0644 /usr/share/limine/BOOTX64.EFI "${esp}/EFI/arch-limine/BOOTX64.EFI"
install -m 0644 /usr/share/limine/BOOTX64.EFI "${esp}/EFI/BOOT/BOOTX64.EFI"
install -m 0644 "$tmp_config" "${esp}/EFI/arch-limine/limine.conf"
install -m 0644 "$tmp_config" "${esp}/EFI/BOOT/limine.conf"
install -m 0644 "$tmp_config" "${esp}/limine.conf"
touch "$marker"

if (( install_mode == 1 )); then
    esp_source="$(findmnt -n -o SOURCE /boot || true)"
    esp_disk="$(lsblk -ndo PKNAME "$esp_source" 2>/dev/null | sed -n '1p' || true)"
    esp_part="$(lsblk -ndo PARTN "$esp_source" 2>/dev/null | sed -n '1p' || true)"
    if [[ -n "$esp_disk" && -n "$esp_part" ]] && efibootmgr >/dev/null 2>&1; then
        if ! efibootmgr 2>/dev/null | grep -Fq 'Nyx Linux (Limine)'; then
            efibootmgr \
                --create \
                --disk "/dev/${esp_disk}" \
                --part "$esp_part" \
                --label 'Nyx Linux (Limine)' \
                --loader '\EFI\arch-limine\BOOTX64.EFI' \
                --unicode || echo "Warning: could not create the Limine UEFI entry; the fallback EFI path was installed." >&2
        fi
    else
        echo "Warning: could not identify the ESP for efibootmgr; the fallback EFI path was installed." >&2
    fi
fi
