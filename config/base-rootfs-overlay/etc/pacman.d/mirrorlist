## Nyx Linux — Arch package mirrors
##
## pacstrap is invoked with -M, so the host mirrorlist is intentionally not
## copied. The target rootfs must still be able to install packages during the
## Calamares "packages" step, which uses this file via /etc/pacman.conf.

## Worldwide (anycast, official Arch infrastructure)
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch

## Official fallbacks
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
Server = https://mirror.dogado.de/archlinux/$repo/os/$arch
Server = https://ftp.halifax.rwth-aachen.de/archlinux/$repo/os/$arch
