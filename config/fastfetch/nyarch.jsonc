// Nyx Linux default fastfetch preset.
//
// Module layout follows the official Nyarch preset from
// https://github.com/LierB/fastfetch (presets/nyarch.jsonc, by Bina), so the
// "title" module prints "user@host" as the very first line — on a stock Nyx
// install that reads "nyx@nyx"-style user@hostname pairs, e.g. "archiso@nyx"
// on the live session.
//
// One deliberate deviation from upstream: the logo is a text file rather than
// ~/.config/fastfetch/images/nyarch.png over the kitty graphics protocol. The
// live and installed systems use Plasma, where konsole does not speak kitty
// images, so a PNG logo would render as nothing at all. Swap "type" to
// "kitty" and point "source" at the png if you want it under kitty.

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/nyarch.ascii",
        "padding": {
            "right": 4
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        "break",
        "break",
        "break",
        {
            "type": "title",
            "keyWidth": 10
        },
        {
            "type": "custom",
            "format": "~~~~~~~~~~~~~~~~~~~~~~~~~~"
        },
        {
            "type": "os",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "kernel",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "shell",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "terminal",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "wm",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "de",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "uptime",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "cpu",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "memory",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "disk",
            "key": "~ ",
            "keyColor": "34",
            "folders": "/"
        },
        {
            "type": "media",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "player",
            "key": "~ ",
            "keyColor": "34"
        },
        "break"
    ]
}
