{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/nyarch.ascii",
    "padding": {
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#67e8f9",
      "title": "#c084fc",
      "output": "#e5e7eb"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "Nyx Linux",
      "color": "#c084fc"
    },
    "break",
    {
      "type": "os",
      "key": "OS",
      "keyColor": "#67e8f9",
      "format": "{name} {version}"
    },
    {
      "type": "host",
      "key": "Host",
      "keyColor": "#67e8f9"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "#67e8f9"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "#67e8f9"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyColor": "#67e8f9"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "#67e8f9"
    },
    {
      "type": "de",
      "key": "DE",
      "keyColor": "#67e8f9"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "#67e8f9"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "#67e8f9"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "#c084fc"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "#c084fc"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "#c084fc"
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "#c084fc",
      "folders": "/"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}
