// Nyx Linux default fastfetch preset.
//
// The module layout is the community Nyarch preset from
// https://github.com/LierB/fastfetch (presets/nyarch.jsonc, by Bina), reused
// because it does one thing well: the "title" module prints "user@host" as the
// very first line. On an install that reads "nyx@nyx"; on the live session,
// "archiso@nyx".
//
// The logo is our own, drawn for this distribution: the peace sign and the word
// NYX, in the same dark grey and cold blue as the rest of the branding. It lives
// in nyx.ascii next to this file.
//
// A text logo rather than ~/.config/fastfetch/images/nyx.png over the kitty
// graphics protocol, on purpose: the live and installed systems use Plasma, where
// konsole does not speak kitty images, and a PNG would render as nothing at all.
// Switch "type" to "kitty" and point "source" at a png if you want it under kitty.

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/nyx.ascii",
        "padding": {
            "right": 4
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        "break",
        "break",
        "break",
        {
            "type": "title",
            "keyWidth": 10
        },
        {
            "type": "custom",
            "format": "~~~~~~~~~~~~~~~~~~~~~~~~~~"
        },
        {
            "type": "os",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "kernel",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "shell",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "terminal",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "wm",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "de",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "uptime",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "cpu",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "memory",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "disk",
            "key": "~ ",
            "keyColor": "34",
            "folders": "/"
        },
        {
            "type": "media",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "player",
            "key": "~ ",
            "keyColor": "34"
        },
        "break"
    ]
}
