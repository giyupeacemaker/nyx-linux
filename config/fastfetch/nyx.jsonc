// Nyx Linux default fastfetch preset.
//
// The module layout is the community Nyarch preset from
// https://github.com/LierB/fastfetch (presets/nyarch.jsonc, by Bina), reused
// because it does one thing well: the "title" module prints "user@host" as the
// very first line. On an install that reads "nyx@nyx"; on the live session,
// "archiso@nyx".
//
// The logo is braille artwork in nyx.ascii, next to this file.
//
// It is text, not an image, and that is the whole point. fastfetch hands a PNG
// to a graphics protocol, and the terminal has to speak one: konsole speaks
// none, so a PNG logo renders as nothing at all there. It was measured rather
// than assumed — "fastfetch --logo logo.jpg" in a terminal without a protocol
// produces three replacement characters and no logo, with COLORTERM set to
// truecolor or not.
//
// Braille is the highest-detail form text has: one cell carries a 2x4 dot
// grid, so this artwork has about 9000 dots against the 600 a block-character
// logo of the same footprint would have. It renders identically in konsole,
// alacritty, foot, xterm or a Windows console, needs no graphics capability
// and no extra package, and the blank cells are U+2800 rather than spaces,
// which keeps every row exactly the same width.
//
// The only requirement is a font that covers U+2800..U+28FF. The image already
// installs DejaVu and Liberation, which both do.

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/nyx.ascii",
        "padding": {
            "right": 4
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        "break",
        "break",
        "break",
        {
            "type": "title",
            "keyWidth": 10
        },
        {
            "type": "custom",
            "format": "~~~~~~~~~~~~~~~~~~~~~~~~~~"
        },
        {
            "type": "os",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "kernel",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "shell",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "terminal",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "wm",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "de",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "uptime",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "cpu",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "memory",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "disk",
            "key": "~ ",
            "keyColor": "34",
            "folders": "/"
        },
        {
            "type": "media",
            "key": "~ ",
            "keyColor": "34"
        },
        {
            "type": "player",
            "key": "~ ",
            "keyColor": "34"
        },
        "break"
    ]
}
